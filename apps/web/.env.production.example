# ============================================================
#  PRODUCTION environment
#  Set these as GitHub Actions secrets / Vercel environment
#  variables scoped to production only.
#  Never commit real values.
# ============================================================

# Stellar — Mainnet for production
NEXT_PUBLIC_STELLAR_NETWORK=PUBLIC
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-rpc.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org

# Production contract deployments
NEXT_PUBLIC_ENERGY_TOKEN_CONTRACT=<production_energy_token_contract>
NEXT_PUBLIC_ENERGY_DISTRIBUTION_CONTRACT=<production_distribution_contract>
NEXT_PUBLIC_COMMUNITY_GOVERNANCE_CONTRACT=<production_governance_contract>

NEXT_PUBLIC_ADMIN_ADDRESS=<production_admin_stellar_address>

# Production API origin
API_URL=https://api.example.com
