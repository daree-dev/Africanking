# Supabase server credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application authentication
JWT_SECRET=
SUPER_ADMIN_ADDRESSES=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stellar testnet and contract configuration
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_ENERGY_TOKEN_CONTRACT=
NEXT_PUBLIC_ENERGY_DISTRIBUTION_CONTRACT=
NEXT_PUBLIC_COMMUNITY_GOVERNANCE_CONTRACT=
MINTER_SECRET_KEY=
# Optional explicit passphrase; must match NEXT_PUBLIC_STELLAR_NETWORK when set
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
# Deployment manifest validated together with the values above (required on PUBLIC)
STELLAR_DEPLOYMENT_MANIFEST=../contracts/deployments/testnet.json
# On invalid config: PUBLIC fails startup by default; set to read-only to keep a read-only API up
STELLAR_CONFIG_ON_ERROR=

# Soroban event indexer (GET/POST /api/indexer/run with Authorization: Bearer <secret>)
INDEXER_CRON_SECRET=
# Optional: archive RPC with longer retention, default cooperative for global contracts, bounds
INDEXER_RPC_URL=
INDEXER_DEFAULT_COOPERATIVE_ID=
INDEXER_START_LEDGER=
INDEXER_PAGE_SIZE=100
INDEXER_MAX_PAGES=20
INDEXER_MAX_BACKFILL_LEDGERS=17280

# Optional wallet provisioning
DFNS_AUTH_TOKEN=
DFNS_PRIVATE_KEY=
DFNS_CRED_ID=
DFNS_BASE_URL=https://api.dfns.io
STELLAR_NETWORK=testnet

# Optional DeFindex integration
DEFINDEX_API_KEY=
DEFINDEX_BASE_URL=https://api.defindex.io
