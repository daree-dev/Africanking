{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "JWT_SECRET",
        "SUPER_ADMIN_ADDRESSES",
        "MINTER_SECRET_KEY",
        "DEFINDEX_API_KEY",
        "DEFINDEX_BASE_URL",
        "DFNS_AUTH_TOKEN",
        "DFNS_PRIVATE_KEY",
        "DFNS_CRED_ID",
        "DFNS_BASE_URL",
        "STELLAR_NETWORK",
        "NEXT_PUBLIC_STELLAR_NETWORK",
        "NEXT_PUBLIC_STELLAR_RPC_URL",
        "NEXT_PUBLIC_STELLAR_HORIZON_URL",
        "NEXT_PUBLIC_ENERGY_TOKEN_CONTRACT",
        "NEXT_PUBLIC_ENERGY_DISTRIBUTION_CONTRACT",
        "NEXT_PUBLIC_COMMUNITY_GOVERNANCE_CONTRACT",
        "NEXT_PUBLIC_APP_URL"
      ],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    }
  }
}
