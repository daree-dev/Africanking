# ============================================================
#  PRODUCTION API environment
#  Set as GitHub Actions secrets / hosting env vars for production.
#  Never commit real values.
# ============================================================

# Supabase — production project
NEXT_PUBLIC_SUPABASE_URL=<production_supabase_url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production_supabase_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<production_supabase_service_role_key>

# Auth
JWT_SECRET=<production_jwt_secret_32chars_min>
SUPER_ADMIN_ADDRESSES=<production_admin_stellar_address>
NEXT_PUBLIC_APP_URL=https://app.example.com

# Stellar — Mainnet
NEXT_PUBLIC_STELLAR_NETWORK=PUBLIC
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-rpc.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org

# Production contracts
NEXT_PUBLIC_ENERGY_TOKEN_CONTRACT=<production_energy_token_contract>
NEXT_PUBLIC_ENERGY_DISTRIBUTION_CONTRACT=<production_distribution_contract>
NEXT_PUBLIC_COMMUNITY_GOVERNANCE_CONTRACT=<production_governance_contract>
MINTER_SECRET_KEY=<production_minter_secret_key>

STELLAR_NETWORK=mainnet
