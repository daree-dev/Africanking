# ============================================================
#  STAGING API environment
#  Set as GitHub Actions secrets / hosting env vars for staging.
#  Never commit real values.
# ============================================================

# Supabase — staging project (separate from local and production)
NEXT_PUBLIC_SUPABASE_URL=<staging_supabase_url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging_supabase_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<staging_supabase_service_role_key>

# Auth
JWT_SECRET=<staging_jwt_secret_32chars_min>
SUPER_ADMIN_ADDRESSES=<staging_admin_stellar_address>
NEXT_PUBLIC_APP_URL=https://app-staging.example.com

# Stellar — Testnet
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Staging contracts (match apps/web/.env.staging.example)
NEXT_PUBLIC_ENERGY_TOKEN_CONTRACT=<staging_energy_token_contract>
NEXT_PUBLIC_ENERGY_DISTRIBUTION_CONTRACT=<staging_distribution_contract>
NEXT_PUBLIC_COMMUNITY_GOVERNANCE_CONTRACT=<staging_governance_contract>
MINTER_SECRET_KEY=<staging_minter_secret_key>

STELLAR_NETWORK=testnet
