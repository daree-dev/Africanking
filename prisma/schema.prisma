// Prisma schema for cooperative credit management.
// NOTE: This project's canonical schema lives in supabase/schema.sql.
// This file mirrors the mint_log / credit integrity constraints added for issue #44
// so Prisma-based tooling sees the same referential integrity guarantees.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cooperative {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members   Member[]
  readings  Reading[]
  mints     MintLog[]

  @@map("cooperatives")
}

model Member {
  id            String      @id @default(uuid())
  cooperativeId String      @map("cooperative_id")
  displayName   String      @map("display_name")
  createdAt     DateTime    @default(now()) @map("created_at")

  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  allocations   Allocation[]
  credits       Credit[]

  @@map("members")
}

model Reading {
  id            String      @id @default(uuid())
  cooperativeId String      @map("cooperative_id")
  memberId      String      @map("member_id")
  valueKwh      Decimal     @map("value_kwh") @db.Decimal(18, 6)
  recordedAt    DateTime    @map("recorded_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  allocations   Allocation[]

  @@map("readings")
}

model Allocation {
  id            String      @id @default(uuid())
  cooperativeId String      @map("cooperative_id")
  readingId     String      @map("reading_id")
  memberId      String      @map("member_id")
  valueKwh      Decimal     @map("value_kwh") @db.Decimal(18, 6)
  createdAt     DateTime    @default(now()) @map("created_at")

  reading       Reading     @relation(fields: [readingId], references: [id])
  member        Member      @relation(fields: [memberId], references: [id])
  credits       Credit[]

  @@map("allocations")
}

model Credit {
  id            String      @id @default(uuid())
  cooperativeId String      @map("cooperative_id")
  allocationId  String      @map("allocation_id")
  memberId      String      @map("member_id")
  amount        Decimal     @db.Decimal(18, 6)
  createdAt     DateTime    @default(now()) @map("created_at")

  allocation    Allocation  @relation(fields: [allocationId], references: [id])
  member        Member      @relation(fields: [memberId], references: [id])
  mints         MintLog[]

  @@map("credits")
}

// Mint status separates confirmed mint history from failed-attempt evidence.
enum MintStatus {
  PENDING
  CONFIRMED
  FAILED

  @@map("mint_status")
}

// A mint log must always reference the logical source operation (reading /
// allocation / credit) and the Stellar transaction that confirms it.
// - creditId is required (NOT NULL) so no orphaned mint evidence can exist.
// - transactionHash is unique among CONFIRMED rows (enforced in SQL via a
//   partial unique index; Prisma models the column and its uniqueness intent).
model MintLog {
  id              String      @id @default(uuid())
  cooperativeId   String      @map("cooperative_id")
  creditId        String      @map("credit_id")
  readingId       String?     @map("reading_id")
  allocationId    String?     @map("allocation_id")
  transactionHash String?     @map("transaction_hash")
  status          MintStatus  @default(PENDING)
  failureReason   String?     @map("failure_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  confirmedAt     DateTime?   @map("confirmed_at")

  cooperative     Cooperative @relation(fields: [cooperativeId], references: [id])
  credit          Credit      @relation(fields: [creditId], references: [id])

  @@unique([transactionHash], name: "mint_log_transaction_hash_key")
  @@index([cooperativeId, status])
  @@index([creditId])
  @@map("mint_log")
}
